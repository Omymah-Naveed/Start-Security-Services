<!-- Service Start -->
<div class="container-xxl py-5">
    <div class="container py-5 px-lg-5">
        <div class="wow fadeInUp" data-wow-delay="0.1s">
            <p class="section-title text-secondary justify-content-center" style="font-size:20px; font-weight:bold;"><span></span>Our Services<span></span></p>
            <h1 class="text-center mb-5">What Services We Provide</h1>
        </div>

        <!-- Bootstrap Multi-Item Carousel -->
        <div id="serviceCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                @if (Model.Man != null && Model.Man.Any())
                {
                    var itemsPerSlide = 3;
                    var totalItems = Model.Man.Count;
                    var slideIndex = 0;

                    for (int i = 0; i < totalItems; i += itemsPerSlide)
                    {
                        <div class="carousel-item @(slideIndex == 0 ? "active" : "")">
                            <div class="row justify-content-center">
                                @for (int j = i; j < i + itemsPerSlide && j < totalItems; j++)
                                {
                                    var item = Model.Man[j];
                                    <div class="col-lg-4 col-md-6 d-flex">
                                        <div class="card border-0 shadow-sm w-100">
                                            <div class="position-relative">
                                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                                {
                                                    <img class="img-fluid w-100 rounded" src="~/img/@item.ImagePath" alt="Service Image" />
                                                }
                                            </div>
                                            <div class="card-body text-center bg-light">
                                                <h3 class="text-danger fw-bold mb-2">@item.Title</h3>
                                                <h5 class="lh-base mb-0">@item.Description</h5>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        slideIndex++;
                    }
                }
                else
                {
                    <div class="carousel-item active">
                        <p class="text-center text-danger fw-bold">No services available.</p>
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-center mt-3">
            <button class="custom-carousel-btn me-3" type="button" data-bs-target="#serviceCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="custom-carousel-btn" type="button" data-bs-target="#serviceCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>
        </div>

 

    </div>
</div>
<!-- Service End -->


<!-- Networks Start -->
<div class="container-xxl py-5">
    <div class="container py-5 px-lg-5">
        <div class="wow fadeInUp" data-wow-delay="0.1s">
            @* <p class="section-title text-secondary justify-content-center"><span></span>Our Network<span></span></p> *@
            <p class="section-title text-secondary justify-content-center" style="font-size:20px; font-weight:bold;"><span></span>Our Network<span></span></p>
            <h1 class="text-center mb-5">Star Security – Protecting Every Region, Every Time.</h1>
        </div>
        <div class="row mt-n2 wow fadeInUp" data-wow-delay="0.3s">
            @* <div class="col-12 text-center"> *@
            @*     <ul class="list-inline mb-5" id="portfolio-flters"> *@
            @*         <li class="mx-2 active" data-filter="*">All</li> *@
            @*         <li class="mx-2" data-filter=".first">North Region</li> *@
            @*         <li class="mx-2" data-filter=".second">West Region</li> *@
            @*         <li class="mx-2" data-filter=".third">East Region</li> *@
            @*         <li class="mx-2" data-filter=".fourth">South Region</li> *@
            @*     </ul> *@
            @* </div> *@
        </div>
        <div class="row g-4 portfolio-container">
            @foreach (var item in Model.Net)
            {
                <div class="col-lg-4 col-md-6 portfolio-item wow fadeInUp" data-wow-delay="0.1s">
                    <div class="rounded overflow-hidden">
                        <div class="position-relative overflow-hidden">
                            @* Ignore image section as per your request *@
                            <div class="portfolio-overlay">
                                <a class="btn btn-square btn-outline-light mx-1" href="" data-lightbox="portfolio"><i class="fa fa-eye"></i></a>
                            </div>
                        </div>
                        <div class="bg-light p-4">
                            <h3 class="text-danger mb-2 text-center" style="font-weight: bold;">@item.Title</h3>
                            <p class="lh-base mb-0">
                                <i class="fa fa-map-marker-alt" style="margin-right: 10px;"></i> @item.Location<br>
                                <i class="fa fa-phone-alt" style="margin-right: 10px;"></i> @item.Cell<br>
                                <i class="fa fa-envelope" style="margin-right: 10px;"></i> <a href="mailto:@item.Email">@item.Email</a>
                            </p>
                            
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Testimonial Start -->
<div class="container-xxl py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container py-5 px-lg-5">
        <p class="section-title text-secondary justify-content-center" style="font-size:20px; font-weight:bold;"><span></span>Reviews<span></span></p>
        <h1 class="text-center mb-5">What Say Our Clients!</h1>

        <div class="owl-carousel testimonial-carousel">
                @if (Model.Tes != null && Model.Tes.Any())
                {
                    foreach (var item in Model.Tes)
                    {
                    <div class="testimonial-item bg-light rounded p-4">
                        <p class="fs-5 text-dark">
                            <i class="fa fa-quote-left fa-4x text-danger mt-4 me-3"></i> @item.Remarks
                        </p>
                        <div class="d-flex align-items-center">
                            <img class="img-fluid flex-shrink-0 rounded-circle" src="img/testimonial_user.png" style="width: 100px; height: 100px;">
                            <div class="ps-4">
                                <h5 class="mb-1">@item.Name</h5>
                            </div>
                        </div>
                    </div>
                    }
                }
                else
                {
                <div class="carousel-item active">
                    <p class="text-center text-danger fw-bold">No Review Available.</p>
                </div>
                }
        </div>

            @if (!isAccepted)
            {
            <div class="text-center">
                <a asp-controller="User" asp-action="CreateReview" class="btn rounded-pill btn-danger w-50 mt-3">Review Us</a>
            </div>
            }
    </div>
</div>
<!-- Testimonial End -->
