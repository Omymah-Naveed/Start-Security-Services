@model Star_Security_Service.Models.BookingViewModel

@{
    ViewData["Title"] = "Book Now";
}





<br />
<br />
<div class="container-xxl py-5">
    <div class="container py-5 px-lg-5">
        <div class="wow fadeInUp" data-wow-delay="0.1s">
            <p class="section-title text-secondary justify-content-center" style="font-size:20px; font-weight:bold;"><span></span>Booking<span></span></p>
            <h1 class="text-center mb-5">Fill This to Start</h1>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="wow fadeInUp" data-wow-delay="0.3s">
                    <form asp-action="Booking" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" asp-for="Name" class="form-control" id="name" placeholder="Your Name" readonly>
                                    <label for="name" asp-for="Name">Your Name</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="email" asp-for="Email" class="form-control" id="email" placeholder="Your Email" readonly>
                                    <label for="email" asp-for="Email">Your Email</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ServiceId" id="serviceDropdown" class="form-control" required>
                                        <option value="">Select Service</option>
                                        @foreach (var service in Model.Services)
                                        {
                                            <option value="@service.Id">@service.Title</option>
                                        }
                                    </select>
                                    <label for="service" >Choose a Service</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="EmployeeId" id="employeeDropdown" class="form-control" required>
                                        <option value="">Select Employee</option>
                                        <!-- Employees will be loaded here dynamically -->
                                    </select>
                                    <label>Choose an Employee</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="BookingDatetime" type="datetime-local" class="form-control" required
                                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                    <label>Choose Date & Time</label>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-12">
                                    <input class="btn sendmsgbtn w-100 py-3 rounded-pill" type="submit" value="Send Message">
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- AJAX Script for Dynamic Employee Selection -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('#serviceDropdown').change(function () {
            var serviceId = $(this).val();
            if (serviceId) {
                $.ajax({
                    url: '/User/GetEmployeesByService',
                    type: 'GET',
                    data: { serviceId: serviceId },
                    success: function (data) {
                        var employeeDropdown = $('#employeeDropdown');
                        employeeDropdown.empty();
                        employeeDropdown.append('<option value="">Select Employee</option>');

                        $.each(data, function (index, employee) {
                            employeeDropdown.append('<option value="' + employee.id + '">' + employee.name + ' - ' + employee.grade + '</option>');
                        });
                    }
                });
            } else {
                $('#employeeDropdown').empty().append('<option value="">Select Employee</option>');
            }
        });
    });
</script>
