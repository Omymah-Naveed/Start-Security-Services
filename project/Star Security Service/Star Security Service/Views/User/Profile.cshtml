@model ProfileViewModel
@inject Star_Security_Service.Data.Star_security_ServiceContext db

@{
    ViewData["Title"] = "Profile";
}

<style>
    .login-container-l {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-box {
        width: 100%;
        padding: 20px;
        background: #ffffff;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
    }

    h2 {
        text-align: center;
        font-weight: bold;
        color: #333;
        margin-bottom: 20px;
    }

    .table-responsive {
        border-radius: 8px;
        overflow: hidden;
    }

    .table th {
        color: black;
        text-align: center;
    }

    .table td {
        text-align: center;
    }

    .delete-btn {
        background: red;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 5px;
        cursor: pointer;
    }

        .delete-btn:hover {
            background: darkred;
        }
</style>

@if (TempData["SuccessMessageBooking"] != null)
{
    <script>
        window.onload = function() {
            var myModal = new bootstrap.Modal(document.getElementById('messageModal'));
            myModal.show();
        };
    </script>

    <!-- Bootstrap Modal -->
    <div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
        <div class="modal-dialog rounded">
            <div class="modal-content">
                <div class="modal-body">
                    <h5 class="text-black text-center">@TempData["SuccessMessageBooking"]</h5>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger w-100 rounded-pill" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (TempData["SuccessMessageDeleteBooking"] != null)
{
    <script>
        window.onload = function() {
            var myModal = new bootstrap.Modal(document.getElementById('messageModal'));
            myModal.show();
        };
    </script>

    <!-- Bootstrap Modal -->
    <div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
        <div class="modal-dialog rounded">
            <div class="modal-content">
                <div class="modal-body">
                    <h5 class="text-black text-center">@TempData["SuccessMessageDeleteBooking"]</h5>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger w-100 rounded-pill" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (TempData["SuccessMessageCareerWithUs"] != null)
{
    <script>
        window.onload = function() {
            var myModal = new bootstrap.Modal(document.getElementById('messageModal'));
            myModal.show();
        };
    </script>

    <!-- Bootstrap Modal -->
    <div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
        <div class="modal-dialog rounded">
            <div class="modal-content">
                <div class="modal-body">
                    <h5 class="text-black text-center">@TempData["SuccessMessageCareerWithUs"]</h5>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger w-100 rounded-pill" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<br />
<br />
<br />
<div class="login-container-l d-flex align-items-center mt-5" style="height: 100vh;">
    <div class="login-box">
        <div class="wow fadeInUp mt-5" data-wow-delay="0.1s">
            <p class="section-title text-secondary justify-content-center"><span></span>Profile Page<span></span></p>
            <h1 class="text-center mb-5">View Your Information</h1>
        </div>

        @{
            var userEmail = Context.Session.GetString("useremail");
            var userName = Context.Session.GetString("username");
            var employeeRecord = db.EmployeeInformations.FirstOrDefault(e => e.Email == userEmail);
            bool isAccepted = employeeRecord != null && employeeRecord.Action == "Accepted";
        }

        <!-- Bookings Table -->
        <h3 class="text-center mt-3">Your Bookings</h3>

        @if (!Model.Bookings.Any())
        {
            <div class="alert alert-warning text-center">No bookings found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Assigned to You</th>
                            <th>Assigned For</th>
                            <th>Consist of</th>
                            <th>Booking Date & Time</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.Bookings)
                        {
                            <tr>
                                <td>@booking.Id</td>
                                <td>@booking.Name</td>
                                <td>@booking.Email</td>
                                <td>@(booking.Employee != null ? booking.Employee.Name : "N/A")</td>
                                <td>@(booking.Service != null ? booking.Service.Title : "N/A")</td>
                                <td>@(booking.Service != null ? booking.Service.Items : "N/A")</td>
                                <td>@booking.BookingDatetime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <form asp-action="DeleteBooking" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@booking.Id" />
                                    <button type="submit" class="btn btn-danger mt-1 w-100" onclick="return confirm('Are you sure you want to delete this request?')">Delete</button>
                                </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <br />

        <!-- Employee Information Table -->
        <h3 class="text-center mt-3">Your Employee Information</h3>

        @if (!Model.EmployeeInfo.Any())
        {
            <div class="alert alert-warning text-center">No employee records found, <br />or<br /> Your request has not been accepted yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Phone Number</th>
                            <th>Qualification</th>
                            <th>Service</th>
                            <th>Grade</th>
                            <th>Achievements</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.EmployeeInfo)
                        {
                            <tr>
                                <td>@employee.Id</td>
                                <td>@employee.Name</td>
                                <td>@employee.Email</td>
                                <td>@employee.Address</td>
                                <td>@employee.Phonenumber</td>
                                <td>@employee.Qualification</td>
                                <td>
                                    @if (employee.ServiceId == 1)
                                    {
                                        <span>Formal Guarding</span>
                                    }
                                    else if (employee.ServiceId == 2)
                                    {
                                        <span>Fire Squad</span>
                                    }
                                    else if (employee.ServiceId == 3)
                                    {
                                        <span>Body Guards</span>
                                    }
                                    else if (employee.ServiceId == 4)
                                    {
                                        <span>Dog Squads</span>
                                    }
                                    else if (employee.ServiceId == 5)
                                    {
                                        <span>Cash Services</span>
                                    }
                                    else
                                    {
                                        <span>Other Services</span>
                                    }
                                </td>
                                <td>@employee.Grade</td>
                                <td>@employee.Achievements</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
<br />
<br />
