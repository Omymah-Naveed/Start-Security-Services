@{
    ViewData["Title"] = "About";
    ViewData["Title"] = "History";
}





<!-- About Start -->
<div class="container-xxl py-5">
    <div class="container py-5 px-lg-5">
        <div class="wow fadeInUp" data-wow-delay="0.1s">
            @* <p class="section-title text-secondary justify-content-center"><span></span>About Us<span></span></p> *@
            <p class="section-title text-secondary justify-content-center mt-2" style="font-size:20px; font-weight:bold;"><span></span>About Us<span></span></p>
            <h1 class="text-center mb-5">Get to Know Us</h1>
        </div>        <div class="row g-5 align-items-center">
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
                <h1 class="mb-5">Star Security Service 25 Years of Experience</h1>
                <p class="mb-4" style="font-size:18px; color=; black;"> <span style="font-weight:bold; font-size:20px; color:#dc2028;">Star Security Services</span> was founded with a mission to provide top-tier security solutions tailored to the needs of businesses and individuals. Established in <mark style="font-weight:bold;">2000</mark>, the company began as a small team of dedicated professionals committed to ensuring safety and peace of mind for clients. Over the years, Star Security Services expanded its operations, integrating advanced technology and highly trained personnel to offer comprehensive security services, including surveillance, on-site guards, and risk assessment. With a reputation for reliability and excellence, the company has grown into a trusted name in the security industry, serving a diverse range of clients across various sectors. Today, Star Security Services continues to uphold its core values of integrity, professionalism, and innovation, ensuring the highest standards of protection for all.</p>
            </div>
            <div class="col-lg-6">
                <img class="img-fluid wow zoomIn" data-wow-delay="0.5s" src="~/logo/Logo02.png">
            </div>
        </div>
    </div>
</div>
<!-- About End -->
<!-- Facts Start -->
<h2 class="text-center text-danger mb-0">Trusted Security Services with Proven Excellence</h2>
<div class="container-xxl bg-dark fact py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container py-5 px-lg-5">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3 text-center wow fadeIn" data-wow-delay="0.1s">
                <i class="fa fa-shield-alt fa-3x text-secondary mb-3"></i>
                <h1 class="text-white mb-2"><span data-toggle="counter-up">25</span>+</h1>
                <p class="text-white mb-0">Years of Security Excellence</p>
            </div>
            <div class="col-md-6 col-lg-3 text-center wow fadeIn" data-wow-delay="0.3s">
                <i class="fa fa-user-shield fa-3x text-secondary mb-3"></i>
                <h1 class="text-white mb-2"><span data-toggle="counter-up">500</span>+</h1>
                <p class="text-white mb-0">Highly Trained Security Personnel</p>
            </div>
            <div class="col-md-6 col-lg-3 text-center wow fadeIn" data-wow-delay="0.5s">
                <i class="fa fa-building fa-3x text-secondary mb-3"></i>
                <h1 class="text-white mb-2"><span data-toggle="counter-up">1000</span>+</h1>
                <p class="text-white mb-0">Protected Businesses & Properties</p>
