    @inject Star_Security_Service.Data.Star_security_ServiceContext db

@{
    ViewData["Title"] = "MannedGuarding";
    Layout = "_Layout";
}
@{
    var userEmail = Context.Session.GetString("useremail");
    var isAccepted = false;

    if (!string.IsNullOrEmpty(userEmail))
    {
        var employeeRecord = db.EmployeeInformations.FirstOrDefault(e => e.Email == userEmail);
        if (employeeRecord != null && (employeeRecord.Action == "Accepted" || employeeRecord.Action == "Freeze"))
        {
            isAccepted = true;
        }
    }

}
@model MannedGuardingModelView
<style>
    /* Change background color of Next & Prev buttons */
    .carousel-control-prev,
    .carousel-control-next {
        background-color: rgba(255, 0, 0, 0.7); /* Change to red with transparency */
        width: 50px; /* Adjust button size */
        height: 50px;
        border-radius: 50%; /* Make it circular */
    }

    /* Change the arrow color */
    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        filter: invert(100%); /* Makes the icon white */
    }

    /* Hover effect */
    .carousel-control-prev:hover,
    .carousel-control-next:hover {
        background-color: rgba(200, 0, 0, 1); /* Darker red */
    }

    <style >
    .custom-carousel-btn {
        background-color: rgba(255, 0, 0, 0.8);
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .custom-carousel-btn:hover {
        background-color: rgba(200, 0, 0, 1);
    }

    .custom-carousel-btn span {
        filter: invert(100%); /* Makes the arrow white */
    }

    .custom-carousel-btn {
        background-color: rgba(255, 0, 0, 0.8); /* Red color */
        width: 50px;
        height: 50px;
        border-radius: 50%; /* Circular buttons */
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10; /* Ensure it's above other elements */
        position: relative; /* Keep it inside the container */
    }

        .custom-carousel-btn:hover {
            background-color: rgba(200, 0, 0, 1); /* Darker red */
        }

        .custom-carousel-btn span {
            filter: invert(100%); /* Makes the arrow white */
        }
</style>
<br />
<br />

<!-- Service Start -->
<div class="container-xxl py-5">
    <div class="container py-5 px-lg-5">
        <div class="wow fadeInUp" data-wow-delay="0.1s">
            @* <p class="section-title text-secondary justify-content-center"><span></span>Our Services<span></span></p> *@
            <p class="section-title text-secondary justify-content-center" style="font-size:20px; font-weight:bold;"><span></span>Our Services<span></span></p>
            <h1 class="text-center mb-5">What Services We Provide</h1>
        </div>

        <!-- Bootstrap Multi-Item Carousel -->
        <div id="serviceCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                    @if (Model.MannedGuardingList != null && Model.MannedGuardingList.Any())
                    {
                        var itemsPerSlide = 3;
                        var totalItems = Model.MannedGuardingList.Count;
                        var slideIndex = 0;

                        for (int i = 0; i < totalItems; i += itemsPerSlide)
                        {
                        <div class="carousel-item @(slideIndex == 0 ? "active" : "")">
                            <div class="row justify-content-center">
                                    @for (int j = i; j < i + itemsPerSlide && j < totalItems; j++)
                                    {
                                        var item = Model.MannedGuardingList[j];
                                    <div class="col-lg-4 col-md-6 d-flex">
                                        <div class="card border-0 shadow-sm w-100">
                                            <div class="position-relative">
                                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                                    {
                                                    <img class="img-fluid w-100 rounded" src="~/img/@item.ImagePath" alt="Service Image" />
                                                    }
                                            </div>
                                            <div class="card-body text-center bg-light">
                                                <h3 class="text-danger fw-bold mb-2">@item.Title</h3>
                                                <h5 class="lh-base mb-0">@item.Description</h5>
                                            </div>
                                        </div>
                                    </div>
                                    }
                            </div>
                        </div>
                            slideIndex++;
                        }
                    }
                    else
                    {
                    <div class="carousel-item active">
                        <p class="text-center text-danger fw-bold">No services available.</p>
                    </div>
                    }
            </div>
        </div>

        <div class="d-flex justify-content-center mt-3">
            <button class="custom-carousel-btn me-3" type="button" data-bs-target="#serviceCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="custom-carousel-btn" type="button" data-bs-target="#serviceCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>
        </div>

        <!-- Book Now Button -->
            @if (!isAccepted)
            {
            <div class="text-center">
                <a asp-controller="User" asp-action="Booking" class="btn rounded-pill btn-danger w-50 mt-3 ">Book Now</a>
            </div>
            }

    </div>
</div>
<!-- Service End -->
<!-- Testimonial Start -->
<div class="container-xxl py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container py-5 px-lg-5">
        <p class="section-title text-secondary justify-content-center" style="font-size:20px; font-weight:bold;"><span></span>Reviews<span></span></p>
        <h1 class="text-center mb-5">What Say Our Clients!</h1>

        <div class="owl-carousel testimonial-carousel">
                @if (Model.Tes != null && Model.Tes.Any())
                {
                    foreach (var item in Model.Tes)
                    {
                    <div class="testimonial-item bg-light rounded p-4">
                        <p class="fs-5 text-dark">
                            <i class="fa fa-quote-left fa-4x text-danger mt-4 me-3"></i> @item.Remarks
                        </p>
                        <div class="d-flex align-items-center">
                            <img class="img-fluid flex-shrink-0 rounded-circle" src="img/testimonial_user.png" style="width: 100px; height: 100px;">
                            <div class="ps-4">
                                <h5 class="mb-1">@item.Name</h5>
                            </div>
                        </div>
                    </div>
                    }
                }
                else
                {
                <div class="carousel-item active">
                    <p class="text-center text-danger fw-bold">No Review Available.</p>
                </div>
                }
        </div>

            @if (!isAccepted)
            {
            <div class="text-center">
                <a asp-controller="User" asp-action="CreateReview" class="btn rounded-pill btn-danger w-50 mt-3">Review Us</a>
            </div>
            }
    </div>
</div>
<!-- Testimonial End -->
