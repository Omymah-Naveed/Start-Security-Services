@model IEnumerable<Star_Security_Service.Models.Booking>

@{
    ViewData["Title"] = "Booking";
}

<h1 class="text-center mb-4">Booking Details</h1>

<table class="table table-striped table-bordered text-center rounded-lg">
    <thead class="">
        <tr>
            <th>Customer Name</th>
            <th>Email</th>
            <th>Booking Date & Time</th>
            <th>Employee</th>
            <th>Service</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.BookingDatetime.ToString("yyyy-MM-dd HH:mm")</td>

                <!-- Employee Name -->
                <td>@(item.Employee != null ? item.Employee.Name : "N/A")</td>

                <!-- Service Title -->
                <td>@(item.Service != null ? item.Service.Title : "N/A")</td>
            </tr>
        }
    </tbody>
</table>
