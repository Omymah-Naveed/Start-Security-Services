@model Star_Security_Service.Models.Network

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Network";
    ViewData["Title"] = "CreateNetwork";
}

<style>
    .container {
        max-width: 600px;
        background: #ffffff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .btn-primary {
        background: #007bff;
        border: none;
        padding: 10px;
        border-radius: 5px;
        font-size: 16px;
    }

        .btn-primary:hover {
            background: #0056b3;
        }
</style>

<div class="container-xxl">
    @* <div class="container py-5 px-lg-5"> *@
        <h1 class="text-center mb-5">Add Network</h1>
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="wow fadeInUp" data-wow-delay="0.3s">
                <form asp-action="CreateNetwork" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Title" class="form-control" required />
                                    <label for="Title">Title</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Cell" class="form-control" required />
                                    <label for="Cell">Cell</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Location" class="form-control" required />
                                    <label for="Location">Location</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Email" class="form-control" type="email" required />
                                    <label for="Email">Email</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary w-100">Add Network</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        @* </div> *@
    </div>
</div>
