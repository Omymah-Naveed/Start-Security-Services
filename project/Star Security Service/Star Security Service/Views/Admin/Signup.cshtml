@model AdminRegisterationCustomViewModel

@{
    ViewData["Title"] = "Signup";
}

<style>
    /* 🌟 Clean and Responsive Signup UI */
    .signup-container {
        max-width: 450px;
        margin: 50px auto;
        padding: 20px;
        background: #ffffff;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
    }

    h2 {
        text-align: center;
        font-weight: bold;
        color: #333;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-control {
        height: 45px;
        font-size: 16px;
        border-radius: 5px;
        border: 1px solid #ddd;
    }

    .btn-primary {
        width: 100%;
        padding: 10px;
        font-size: 18px;
        border-radius: 5px;
        background-color: #007bff;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .alert {
        text-align: center;
        font-size: 16px;
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 15px;
        color: #007bff;
        text-decoration: none;
        font-size: 16px;
    }

        .back-link:hover {
            text-decoration: underline;
        }
</style>

<div class="signup-container">
    <h2>Signup</h2>

    @if (TempData["ErrorMessageSignup"] != null)
    {
        <script>
            window.onload = function() {
                var myModal = new bootstrap.Modal(document.getElementById('messageModal'));
                myModal.show();
            };
        </script>

        <!-- Bootstrap Modal -->
        <div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
            <div class="modal-dialog rounded">
                <div class="modal-content">
                    <div class="modal-body">
                        <h5 class="text-black text-center">@TempData["ErrorMessageSignup"]</h5>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger w-100 rounded-pill" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <form asp-action="Signup" method="post">
        <div class="form-group">
            <label asp-for="registrationFormData.Name">Name</label>
            <input asp-for="registrationFormData.Name" class="form-control" placeholder="Enter your name" required />
        </div>

        <div class="form-group">
            <label asp-for="registrationFormData.Email">Email</label>
            <input asp-for="registrationFormData.Email" class="form-control" type="email" placeholder="Enter your email" required />
        </div>

        <div class="form-group">
            <label asp-for="registrationFormData.Password">Password</label>
            <input asp-for="registrationFormData.Password" type="password" class="form-control" placeholder="Enter your password" required />
        </div>

        @if (Model.RoleList == null || !Model.RoleList.Any())
        {
            <p class="text-danger text-center">⚠️ No roles found! Please contact admin.</p>
        }
        else
        {
            <div class="form-group">
                <label asp-for="registrationFormData.Role">Select Role</label>
                <select asp-for="registrationFormData.Role" class="form-control">
                    <option value="">-- Select Role --</option>
                    @foreach (var item in Model.RoleList)
                    {
                        <option value="@item.Id"> @item.Role</option>
                    }
                </select>
            </div>
        }


        <button type="submit" class="btn btn-primary">Register</button>
    </form>

    <a asp-action="Login" asp-controller="Admin" class="back-link">Already have an account? Login</a>
</div>
