@model IEnumerable<Star_Security_Service.Models.Network>

@{
    Layout = "_LayoutAdmin"; 
    ViewData["Title"] = "Network";
}

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Arial', sans-serif;
    }

    /* 🌟 Centered Title */
    .page-title {
        text-align: center;
        font-weight: bold;
        color: #333;
        margin-bottom: 20px;
        padding-top: 10px;
    }

    .table {
        border-radius: 8px;
        overflow: hidden;
    }

    /* 🌟 Button Styling */
    .btn-edit {
        background: #ffc107;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 5px;
        font-size: 14px;
        transition: 0.3s;
    }

        .btn-edit:hover {
            background: #e0a800;
        }

    .btn-delete {
        background: #dc3545;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 5px;
        font-size: 14px;
        transition: 0.3s;
    }

        .btn-delete:hover {
            background: #c82333;
        }

</style>
@if (TempData["SuccessMessageNetwork"] != null)
{
    <script>
        window.onload = function() {
            var myModal = new bootstrap.Modal(document.getElementById('messageModal'));
            myModal.show();
        };
    </script>

    <!-- Bootstrap Modal -->
    <div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
        <div class="modal-dialog rounded">
            <div class="modal-content">
                <div class="modal-body">
                    <h5 class="text-black text-center">@TempData["SuccessMessageNetwork"]</h5>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger w-100 rounded-pill" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
<h2 class="page-title">Network Information</h2>
<div class="text-center">
<a asp-controller="Admin" asp-action="CreateNetwork" class="btn rounded-pill btn-danger w-50 mt-3 ">Add Data</a>
</div>
<br />

@if (!Model.Any())
{
    <div class="alert alert-warning text-center">No network records found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered text-center rounded-lg">
            <thead class="rounded-top">
                <tr>
                    <th>#</th>
                    <th>Title</th>
                    <th>Cell</th>
                    <th>Location</th>
                    <th>Email</th>
                    <th>Manage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Title</td>
                        <td>@item.Cell</td>
                        <td>@item.Location</td>
                        <td>@item.Email</td>
                        <td>
                            @* <a asp-action="EditNetwork" asp-route-id="@item.Id" class="btn btn-edit w-100">Edit</a> *@
                            <form asp-action="DeleteNetwork" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-delete mt-1 w-100" onclick="return confirm('Are you sure you want to delete this entry?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
