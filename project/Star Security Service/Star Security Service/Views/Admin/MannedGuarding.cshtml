@model MannedGuardingModelView

@{
    ViewData["Title"] = "MannedGuarding";
}

@if (TempData["ErrorMessageMannedGuarding"] != null)
{
    <script>
        window.onload = function() {
            var myModal = new bootstrap.Modal(document.getElementById('messageModal'));
            myModal.show();
        };
    </script>

    <!-- Bootstrap Modal -->
    <div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
        <div class="modal-dialog rounded">
            <div class="modal-content">
                <div class="modal-body">
                    <h5 class="text-black text-center">@TempData["ErrorMessageMannedGuarding"]</h5>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger w-100 rounded-pill" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Contact Form Layout for Uploading -->
<div class="container-xxl">
    <div class="container py-5 px-lg-5">
        <div class="wow fadeInUp" data-wow-delay="0.1s">
            <h1 class="text-center mb-5">Upload Services</h1>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="wow fadeInUp" data-wow-delay="0.3s">
                    <form asp-action="MannedGuarding" enctype="multipart/form-data" method="post" class="shadow p-4 rounded bg-white">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Title" class="form-control" required placeholder="Enter Service Title">
                                    <label asp-for="Title">Service Title</label>
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Description" class="form-control" required placeholder="Enter Description">
                                    <label asp-for="Description">Service Description</label>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <input asp-for="Image" type="file" class="form-control" required>
                                    <label asp-for="Image">Upload Image</label>
                                    <span asp-validation-for="Image" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary w-100 rounded-pill">Upload Service</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<h2 class="text-center mt-1 mb-1">Service List</h2>
<table class="table table-striped table-bordered text-center rounded-lg">
    <thead class="rounded-top">
        <tr>
            <th>#</th>
            <th>Title</th>
            <th>Description</th>
            <th>Consist Of</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.MannedGuardingList != null && Model.MannedGuardingList.Any())
        {
            @foreach (var item in Model.MannedGuardingList)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Title</td>
                    <td>@item.Description</td>
                    <td>@item.Items</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="~/img/@item.ImagePath" width="100" height="100" alt="Image" />
                        }
                        else
                        {
                            <span>No Image</span>
                        }
                    </td>
                    <td>
                        <a asp-action="EditMannedGuarding" asp-route-id="@item.Id" class="btn btn-warning w-100">Edit</a>
                        <form asp-action="DeleteMannedGuarding" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-danger mt-1 w-100" onclick="return confirm('Are you sure you want to delete this request?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No records found.</td>
            </tr>
        }
    </tbody>
</table>