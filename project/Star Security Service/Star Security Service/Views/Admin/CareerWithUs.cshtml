@model IEnumerable<Star_Security_Service.Models.EmployeeInformation>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "CareerWithUs";
}

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Arial', sans-serif;
    }

    /* 🌟 Centered Title */
    .page-title {
        text-align: center;
        font-weight: bold;
        color: #333;
        margin-bottom: 20px;
        padding-top: 10px;
    }

    .table {
        border-radius: 8px;
        overflow: hidden;
    }

    /* 🌟 Button Styling */
    .btn-accept {
        background: #28a745;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 5px;
        font-size: 14px;
        transition: 0.3s;
    }

        .btn-accept:hover {
            background: #218838;
        }

</style>
<h2 class="page-title">Employee Information</h2>
@if (TempData["ErrorMessageEditEmployeeRequest"] != null)
{
    <script>
        window.onload = function() {
            var myModal = new bootstrap.Modal(document.getElementById('messageModal'));
            myModal.show();
        };
    </script>

    <!-- Bootstrap Modal -->
    <div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
        <div class="modal-dialog rounded">
            <div class="modal-content">
                <div class="modal-body">
                    <h5 class="text-black text-center">@TempData["ErrorMessageEditEmployeeRequest"]</h5>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger w-100 rounded-pill" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
@if (!Model.Any())
{
    <div class="alert alert-warning text-center">No career requests found.</div>
}
else
{

    <div class="table-responsive">
        <table class="table table-striped table-bordered text-center rounded-lg">
            <thead class="rounded-top">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Phone Number</th>
                    <th>Qualification</th>
                    <th>Service</th>
                    <th>Grade</th>
                    <th>Achievements</th>
                    <th>Action</th>
                    <th>Manage</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Address</td>
                        <td>@item.Phonenumber</td>
                        <td>@item.Qualification</td>
                        <td>
                            @if (item.ServiceId == 1)
                            {
                                <span>Formal Guarding</span>
                            }
                            else if (item.ServiceId == 2)
                            {
                                <span>Fire Squad</span>
                            }
                            else if (item.ServiceId == 3)
                            {
                                <span>Body Guards</span>
                            }
                            else if (item.ServiceId == 4)
                            {
                                <span>Dog Squads</span>
                            }
                            else if (item.ServiceId == 5)
                            {
                                <span>Cash Services</span>
                            }
                            else
                            {
                                <span>Other Service</span>
                            }
                        </td>
                        <td>@item.Grade</td>
                        <td>@item.Achievements</td>
                        <td>@item.Action</td>
                        <td>
                            <a asp-action="EditEmployeeRequest" asp-route-id="@item.Id" class="btn btn-warning w-100">Edit</a>
                            <form asp-action="UpdateEmployeeAction" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-success mt-1 w-100" onclick="return confirm('Are you sure you want to accept this request?')">Accept</button>
                            </form>
                            <form asp-action="DeleteEmployeeRequest" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-danger mt-1 w-100" onclick="return confirm('Are you sure you want to delete this request?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

}

