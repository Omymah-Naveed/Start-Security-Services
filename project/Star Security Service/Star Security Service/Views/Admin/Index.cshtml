@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Dashboard";
}
@model DashViewModel

<!-- Centered Title -->
<h2 class="text-center mb-4 mt-4">Contact Messages</h2>

@if (Context.Session.GetString("userroleadmin") == "2") 
{
    @if (!Model.Con.Any())
    {
        <div class="alert alert-warning text-center">No contact messages found.</div>
    }
    else
    {
        <table class="table table-striped table-bordered text-center rounded-lg">
            <thead class="rounded-top">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Email</th>
                    <th scope="col">Phone Number</th>
                    <th scope="col">Subject</th>
                    <th scope="col">Message</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Con)
                {
                    <tr>
                        <th scope="row">@item.Id</th>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Phonenumber</td>
                        <td>@item.Subject</td>
                        <td>@item.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else
{
    <div class="alert alert-danger text-center">Access Denied: Only Admins can view this table.</div>
}

<h2 class="text-center mb-4 mt-4">Testimonials</h2>

@if (Context.Session.GetString("userroleadmin") == "2")
{
    @if (!Model.Tes.Any())
    {
        <div class="alert alert-warning text-center">No contact messages found.</div>
    }
    else
    {
        <table class="table table-striped table-bordered text-center rounded-lg">
            <thead class="rounded-top">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Tes)
                {
                    <tr>
                        <th scope="row">@item.Id</th>
                        <td>@item.Name</td>
                        <td>@item.Remarks</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else
{
    <div class="alert alert-danger text-center">Access Denied: Only Admins can view this table.</div>
}
