
<!DOCTYPE html>
<html lang="en">

<head>
    @inject Star_Security_Service.Data.Star_security_ServiceContext db

    <meta charset="utf-8">
    <title>Star Security Services</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="~/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500&family=Jost:wght@500;600;700&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="~/lib/lightbox/css/lightbox.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/css/user_style.css" rel="stylesheet">
</head>
<style>
    .dropdown-toggle::after {
        content: "" !important;
    }

</style>
<body>
    <div class="container-xxl bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-grow text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->
        <!-- Navbar & Hero Start -->
        <div class="container-xxl position-relative p-0">
            <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-3 py-lg-0">
                @* <a href="" class="navbar-brand p-0"> *@
                    <a asp-controller="User" asp-action="Index" class="navbar-brand p-0 @(ViewData["Title"]?.ToString() == "Index"?"active":"")">
                    <img src="~/logo/Logo01.png" alt="Logo">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                    <span class="fa fa-bars"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCollapse">
                    <div class="navbar-nav mx-auto py-0">
                        <a asp-controller="User" asp-action="Index" class="nav-item nav-link @(ViewData["Title"]?.ToString() == "Index"?"active":"")">Home</a>

                        <!-- Corrected Dropdown -->
                        <div class="nav-item dropdown">
                            <a class="nav-link @(ViewData["Title"]?.ToString() == "About"?"active":"")" href="#" id="aboutDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                About Us <i class="fa fa-angle-down ms-1"></i>
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="aboutDropdown">
                                <li><a asp-controller="User" asp-action="OurNetwork" class="dropdown-item @(ViewData["Title"]?.ToString() == "OurNetwork"?"active":"")">Our Network</a></li>
                                <li><a asp-controller="User" asp-action="About" class="dropdown-item @(ViewData["Title"]?.ToString() == "History"?"active":"")">Our History</a></li>
                            </ul>
                        </div>



                        <a asp-controller="User" asp-action="MannedGuarding" class="nav-item nav-link @(ViewData["Title"]?.ToString() == "MannedGuarding"?"active":"")">Our Business</a>
                        <a asp-controller="User" asp-action="Contact" class="nav-item nav-link @(ViewData["Title"]?.ToString() == "Contact"?"active":"")">Contact</a>

                        @{
                            var userEmail = Context.Session.GetString("useremail");
                            var isAccepted = false;

                            if (!string.IsNullOrEmpty(userEmail))
                            {
                                var employeeRecord = db.EmployeeInformations.FirstOrDefault(e => e.Email == userEmail);
                                if (employeeRecord != null && (employeeRecord.Action == "Accepted" || employeeRecord.Action == "Freeze"))
                                {
                                    isAccepted = true;
                                }
                            }
                        }

                        @if (!isAccepted)
                        {
                            <a asp-controller="User" asp-action="CareerWithUs" class="nav-item nav-link @(ViewData["Title"]?.ToString() == "CareerWithUs"?"active":"")">Careers With Us</a>
                        }
                    </div>

                    <!-- Login/Profile Section -->
                    <!-- Login/Profile Section -->
                    <div class="d-flex ms-auto">
                        <div class="dropdown">
                            @if (!string.IsNullOrEmpty(Context.Session.GetString("useremail")))
                            {
                                <button class="btn dropdown-toggle rounded-pill py-2 px-4 ms-3 border-danger" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Context.Session.GetString("username")
                                </button>
                                <ul class="dropdown-menu dropdown-menu-light">
                                    <li><a class="dropdown-item @(ViewData["Title"]?.ToString() == "Profile"?"active":"")" asp-controller="User" asp-action="Profile">Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="User" asp-action="Logout">Logout</a></li>
                                </ul>
                            }
                            else
                            {
                                <a asp-controller="User" asp-action="Login" class="btn rounded-pill py-2 px-4 ms-3 border-danger">Login</a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </div>
        <!-- Navbar End -->
        <!-- Footer Start -->
        @RenderBody()
        <div class="container-fluid bg-light text-dark footer wow fadeIn" data-wow-delay="0.1s">
            <div class="container py-5 px-lg-5">
                <div class="row g-5">

                    <div class="col-md-6 col-lg-3">
                        <a href="">
                            <img src="~/logo/Logo01.png" alt="Logo" style="width: 150px; height: auto;">
                        </a>
                        <p class="pt-4">
                            Star Security Services is committed to providing top-tier security solutions. Trust Star Security Services — Your shield of safety and peace of mind.
                        </p>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <p class="section-title text-dark text-center h5 mb-4" style="font-weight: bold;">Address</p>
                        <p><i class="fa fa-map-marker-alt me-3"></i>Aptech North Nazimabad Center, Karachi</p>
                        <p><i class="fa fa-phone-alt me-3"></i>+012 345 67890</p>
                        <p><i class="fa fa-envelope me-3"></i>info@example.com</p>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <p class="section-title text-dark h5 mb-4" style="font-weight: bold;">QuickLinks</p>
                        <a asp-controller="User" asp-action="Index" class="btn btn-link @(ViewData["Title"]?.ToString() == "Index"?"active":"")">Home</a>
                        <a asp-controller="User" asp-action="About" class="btn btn-link @(ViewData["Title"]?.ToString() == "History"?"active":"")">Our History</a>
                        <a asp-controller="User" asp-action="Contact" class="btn btn-link @(ViewData["Title"]?.ToString() == "Contact"?"active":"")">Contact</a>
                        <a asp-controller="User" asp-action="MannedGuarding" class="btn btn-link @(ViewData["Title"]?.ToString() == "MannedGuarding"?"active":"")">Our Business</a>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <p class="section-title text-dark h5 mb-4 text-center" style="font-weight: bold;">Social Links</p>
                        <div class="row g-2">
                            <div class="d-flex pt-2">
                                <a class="btn btn-outline-dark btn-social" href="https://twitter.com" target="_blank"><i class="fab fa-twitter"></i></a>
                                <a class="btn btn-outline-dark btn-social" href="https://www.facebook.com" target="_blank"><i class="fab fa-facebook-f"></i></a>
                                <a class="btn btn-outline-dark btn-social" href="https://www.instagram.com" target="_blank"><i class="fab fa-instagram"></i></a>
                                <a class="btn btn-outline-dark btn-social" href="https://www.linkedin.com" target="_blank"><i class="fab fa-linkedin-in"></i></a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="container px-lg-5">
                <div class="copyright">
                    <div class="row">
                        <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                            &copy; <a class="border-bottom" href="#">Star Security Services</a>, All Right Reserved.
                            Designed By <a class="border-bottom" href="">Omymah</a>
                        </div>
                        <div class="col-md-6 text-center text-md-end">
                            <div class="footer-menu">
                                <a href="">Home</a>
                                <a href="">About</a>
                                <a href="">Services</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Footer End -->
        <!-- Back to Top -->
        <a href="#" class="btn btn-lg btn-secondary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/wow/wow.min.js"></script>
    <script src="~/lib/easing/easing.min.js"></script>
    <script src="~/lib/waypoints/waypoints.min.js"></script>
    <script src="~/lib/counterup/counterup.min.js"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/lib/isotope/isotope.pkgd.min.js"></script>
    <script src="~/lib/lightbox/js/lightbox.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/js/user_main.js"></script>
</body>

</html>